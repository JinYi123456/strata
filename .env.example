# STRATA configuration.
#
# Copy to `.env` and fill in what you need. Everything here is optional: with
# nothing set, the service runs on local disk and the agent uses its
# deterministic policy. Nothing in the product requires a model to be reachable.
#
#   cp .env.example .env

# ── Runtime ──────────────────────────────────────────────────────────────
# Port to listen on. When set, the service binds 0.0.0.0 automatically.
# PORT=8000
# STRATA_HOST=0.0.0.0
STRATA_LOG_LEVEL=info

# Where the local store keeps sessions and panels.
STRATA_DATA_DIR=data

# Built console to serve. Defaults to service/static, then web/out.
# STRATA_STATIC_DIR=service/static

# Comma-separated origins allowed to call the API from a browser.
# STRATA_CORS_ORIGINS=https://example.com

# Maximum simultaneous scans. Lower this on a memory-constrained host.
# STRATA_MAX_CONCURRENT_SCANS=2

# ── Storage ──────────────────────────────────────────────────────────────
# local (default) or aws.
STRATA_EXECUTOR=local

# Only used when STRATA_EXECUTOR=aws.
# STRATA_S3_BUCKET=
# STRATA_DDB_TABLE=
# STRATA_AWS_REGION=us-east-1

# ── Feature backend ──────────────────────────────────────────────────────
# auto (default) prefers ALIKED + LightGlue when the weights are present and
# falls back to SIFT when they are not. Force a backend with:
#   auto | aliked | sift | orb
# STRATA_BACKEND=auto
# STRATA_MODEL_DIR=vision/models

# ── Agent model (optional) ───────────────────────────────────────────────
# The agent's decision layer is a deterministic policy. A model can be consulted
# at exactly one call site — to justify why another view is wanted — and if the
# call fails for any reason the run continues on the rules with the error
# recorded in the trace.
#
# Set ONE of the following. Each provider has a free tier.
#
# Groq — fastest; the agent loop is on camera in the demo, so latency shows.
# https://console.groq.com/keys
# GROQ_API_KEY=
#
# Google AI Studio (Gemini)
# https://aistudio.google.com/apikey
# GEMINI_API_KEY=
#
# OpenRouter — includes free models
# https://openrouter.ai/keys
# OPENROUTER_API_KEY=
#
# Featherless AI — open-weight models
# https://featherless.ai
# FEATHERLESS_API_KEY=
