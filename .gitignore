# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / Next.js ---
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# --- Model weights (fetched by scripts/fetch_models.py) ---
# Not committed: a repository carrying 52 MB of binaries is a repository that
# gets slow to clone, and the pipeline runs without them on a SIFT fallback.
vision/models/*.onnx
vision/models/*.pt
vision/models/*.pth
!vision/models/.gitkeep

# --- Local data and generated media ---
data/
sessions/
artifacts/
*.mp4
*.mov
*.avi
*.mkv
*.png
*.jpg
*.jpeg
*.webp
!docs/**/*.png
!docs/**/*.svg
!web/public/**/*.png
!service/static/media/*.mp4
!web/public/**/*.svg

# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Build and infrastructure output ---
build/
.cache/
aws-sam/
samconfig.toml
.aws-sam/

# --- Local tooling state ---
# Working notes and editor directories that belong to whoever is at the machine
# rather than to the project. Kept generic on purpose: the repository should not
# carry a record of which tools a contributor happens to run. Anything specific
# to one machine belongs in .git/info/exclude, which is never committed.
.*-ai/
.*-agent/
.*-state/
